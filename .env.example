# =============================================================
# Project IRQ — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyala: cp .env.example .env
# .env dosyasını asla git'e commit ETME
# =============================================================

# ── Telegram ──────────────────────────────────────────────────
# BotFather'dan aldığın Telegram bot token'ı
TELEGRAM_TOKEN=BURAYA_TOKEN_YAZ

# Telegram'da /start yazınca öğrenilir
ADMIN_CHAT_ID=BURAYA_CHAT_ID_YAZ

# ── Genel ─────────────────────────────────────────────────────
# Ortam: dev | prod
ENV=dev

# Log seviyesi: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Claude Code (Faz 3-4) ────────────────────────────────────
# Varsayılan Claude Code modeli
CLAUDE_MODEL=claude-sonnet-4-20250514

# Claude Code max çalışma süresi (saniye)
CLAUDE_TIMEOUT=300

# ── Maliyet Kontrolü (Faz 7) ─────────────────────────────────
# Günlük maliyet limiti (USD)
COST_LIMIT_USD=5.0
