# Ortam ve gizli dosyalar
.env
.env.*
!.env.example

# Python cache / build
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/

# Loglar
logs/
*.log

# IDE ve editör dosyaları
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store
Thumbs.db

# Git iç dosyaları
.git/

# Gemini / Antigravity kendi dizinleri
.gemini/
